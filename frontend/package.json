{
  "name": "nexpaper-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/scanner-assets.mjs && node scripts/pdfjs-assets.mjs",
    "dev": "vite",
    "prebuild": "node scripts/scanner-assets.mjs && node scripts/pdfjs-assets.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.2.0",
    "@fontsource-variable/fraunces": "^5.2.0",
    "i18next": "^25.6.1",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.4",
    "react-router-dom": "^7.9.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.16",
    "@techstark/opencv-js": "5.0.0-release.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.12",
    "vitest": "^4.1.11"
  }
}
